.venv/
.uv-cache/
# vendor/ is gitignored as it is locally regenerated — except the pinned
# RISC-V docs snapshot, which is committed on purpose: CI validation must not
# depend on the docs.riscv.org site being healthy mid-migration.
vendor/*
!vendor/riscv/
vendor/riscv/*
!vendor/riscv/docs_pages.json
!vendor/intel_guide/
vendor/intel_guide/*
!vendor/intel_guide/*.json
!vendor/intel_optref/
vendor/intel_optref/*
!vendor/intel_optref/*.json
!vendor/instlatx64/
vendor/instlatx64/*
!vendor/instlatx64/*.json
!vendor/amd_swopt/
vendor/amd_swopt/*
!vendor/amd_swopt/*.json
!vendor/arm_swopt/
vendor/arm_swopt/*
!vendor/arm_swopt/*.json
data/derived/
web/
share/man/
__pycache__/
*.pyc
dist/
*.egg-info/
build/

# Intel SDM PDF (downloaded during update, not redistributed)
vendor/intel/*.pdf
.codex
.coverage
.claude/
simdref.sqlite
